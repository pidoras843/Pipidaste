-- Portal Gun Script
local OrionLib = loadstring(game:HttpGet(("https://raw.githubusercontent.com/shlexware/Orion/main/source")))()

if not OrionLib then
    warn("Failed to load Orion Library")
    return
end

local Window = OrionLib:MakeWindow({
    Name = "Portal Gun Menu",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "PortalGun"
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local UserInputService = game:GetService("UserInputService")

local portalGunEnabled = false
local currentPortal = nil
local shiftLocked = false
local portalConnection = nil

local function CreatePortal(position)
    if currentPortal then 
        currentPortal:Destroy() 
        currentPortal = nil
    end
    
    local portal = Instance.new("Part")
    portal.Size = Vector3.new(8, 1, 8)
    portal.Position = position
    portal.Anchored = true
    portal.CanCollide = false
    portal.Material = Enum.Material.Neon
    portal.BrickColor = BrickColor.new("Bright green")
    portal.Transparency = 0.3
    portal.Parent = workspace

    local beam = Instance.new("Attachment", portal)
    local beam2 = Instance.new("Attachment", portal)
    beam2.Position = Vector3.new(0, 2, 0)
    local trail = Instance.new("Trail", portal)
    trail.Attachment0 = beam
    trail.Attachment1 = beam2
    trail.Color = ColorSequence.new(Color3.fromRGB(0, 255, 0))
    trail.Lifetime = 0.5
    trail.WidthScale = NumberSequence.new(2)

    local touch = Instance.new("Script", portal)
    touch.Name = "TeleportScript"
    touch.Source = [[
        script.Parent.Touched:Connect(function(hit)
            local player = game:GetService("Players"):GetPlayerFromCharacter(hit.Parent)
            if player and player == game:GetService("Players").LocalPlayer then
                local humanoid = hit.Parent:FindFirstChild("Humanoid")
                if humanoid then
                    local rootPart = hit.Parent:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local newPos = script.Parent.Position + Vector3.new(0, 3, 0)
                        rootPart.CFrame = CFrame.new(newPos)
                    end
                end
            end
        end)
    ]]
    touch.Disabled = false

    currentPortal = portal
    return portal
end

local function PortalGun()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ray = Ray.new(hrp.Position, Mouse.Hit.LookVector * 100)
    local hit, position = workspace:FindPartOnRay(ray, char)
    if hit then
        CreatePortal(position + Vector3.new(0, 1, 0))
        OrionLib:MakeNotification({
            Name = "Portal Gun",
            Content = "Portal created",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
    end
end

local function ShowCoordinates()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local pos = hrp.Position
        local coords = string.format("X: %.1f Y: %.1f Z: %.1f", pos.X, pos.Y, pos.Z)
        OrionLib:MakeNotification({
            Name = "Coordinates",
            Content = coords,
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
end

local function TogglePortalGun()
    portalGunEnabled = not portalGunEnabled
    if portalGunEnabled then
        OrionLib:MakeNotification({
            Name = "Portal Gun",
            Content = "Activated",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
        portalConnection = Mouse.Button1Down:Connect(function()
            if portalGunEnabled then
                PortalGun()
            end
        end)
    else
        if portalConnection then
            portalConnection:Disconnect()
            portalConnection = nil
        end
        OrionLib:MakeNotification({
            Name = "Portal Gun",
            Content = "Deactivated",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
    end
end

local RickTab = Window:MakeTab({
    Name = "Rick",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

RickTab:AddSection({
    Name = "Portal Gun"
})

RickTab:AddButton({
    Name = "Standard Portal Gun",
    Callback = function()
        TogglePortalGun()
    end
})

RickTab:AddButton({
    Name = "Show Coordinates",
    Callback = function()
        ShowCoordinates()
    end
})

RickTab:AddButton({
    Name = "Shift Lock",
    Callback = function()
        shiftLocked = not shiftLocked
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.AutoRotate = not shiftLocked
            end
        end
        OrionLib:MakeNotification({
            Name = "Shift Lock",
            Content = shiftLocked and "Enabled" or "Disabled",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
    end
})

RickTab:AddButton({
    Name = "Remove Portal",
    Callback = function()
        if currentPortal then
            currentPortal:Destroy()
            currentPortal = nil
            OrionLib:MakeNotification({
                Name = "Portal Removed",
                Content = "Portal deleted",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        else
            OrionLib:MakeNotification({
                Name = "Portal Removed",
                Content = "No active portal",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        end
    end
})

RickTab:AddButton({
    Name = "Coming Soon: Morty Portal Gun",
    Callback = function()
        OrionLib:MakeNotification({
            Name = "Coming Soon",
            Content = "Morty portal gun in development",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
})

RickTab:AddButton({
    Name = "Coming Soon: Rick Bot Portal Gun",
    Callback = function()
        OrionLib:MakeNotification({
            Name = "Coming Soon",
            Content = "Rick bot portal gun in development",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
})

RickTab:AddButton({
    Name = "Coming Soon: Green Portal Gun",
    Callback = function()
        OrionLib:MakeNotification({
            Name = "Coming Soon",
            Content = "Green portal gun in development",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
})

local MortyTab = Window:MakeTab({
    Name = "Morty",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MortyTab:AddSection({
    Name = "Morty Portals"
})

MortyTab:AddButton({
    Name = "Create Morty Portal",
    Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local pos = char.HumanoidRootPart.Position + Vector3.new(0, 2, 0)
            CreatePortal(pos)
            OrionLib:MakeNotification({
                Name = "Morty Portal",
                Content = "Portal created",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        end
    end
})

MortyTab:AddButton({
    Name = "Clear All Portals",
    Callback = function()
        local count = 0
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Part") and v.BrickColor == BrickColor.new("Bright green") and v.Name == "Part" then
                if v:FindFirstChild("TeleportScript") then
                    v:Destroy()
                    count = count + 1
                end
            end
        end
        currentPortal = nil
        OrionLib:MakeNotification({
            Name = "Cleaned",
            Content = "Cleared " .. count .. " portals",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
    end
})

MortyTab:AddButton({
    Name = "Coming Soon: Morty Special",
    Callback = function()
        OrionLib:MakeNotification({
            Name = "Coming Soon",
            Content = "Morty special abilities in development",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
})

LocalPlayer.CharacterAdded:Connect(function()
    if currentPortal then
        currentPortal:Destroy()
        currentPortal = nil
    end
    if portalConnection then
        portalConnection:Disconnect()
        portalConnection = nil
        portalGunEnabled = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Z then
        TogglePortalGun()
    elseif input.KeyCode == Enum.KeyCode.X then
        ShowCoordinates()
    elseif input.KeyCode == Enum.KeyCode.C then
        if currentPortal then
            currentPortal:Destroy()
            currentPortal = nil
            OrionLib:MakeNotification({
                Name = "Portal Removed",
                Content = "Portal deleted",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        end
    end
end)

OrionLib:Init()
